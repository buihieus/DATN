# API Configuration
# Uncomment the appropriate line for your environment:

# Android Emulator (default)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Real Device on LAN - YOUR CURRENT IP: 192.168.16.100
EXPO_PUBLIC_API_URL=http://192.168.16.100:3000

# iOS Simulator
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Web browser
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Crypto Secret Key (must match server's SECRET_CRYPTO)
EXPO_PUBLIC_SECRET_CRYPTO='123456'
